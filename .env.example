# ──────────────────────────────────────────────────────────────
# Grace Cathedral Church — Environment Variables
# Copy this file to `.env.local` for local development.
# On Vercel: Project → Settings → Environment Variables.
# Everything below is OPTIONAL — the site works without any of it.
# ──────────────────────────────────────────────────────────────

# Canonical site URL (used for SEO / sitemap / Open Graph)
NEXT_PUBLIC_SITE_URL=https://grace-cathedral-church.vercel.app

# Google Analytics 4 — measurement ID (e.g. G-ABC123XYZ)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Contact form (Nodemailer) ─────────────────────────────────
# Any SMTP provider works (Gmail app-password, Brevo, Resend SMTP, etc.)
# If unset, contact submissions are validated + logged instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=office@gracecathedral.co.ke

# ── Newsletter storage (Vercel KV / Upstash Redis REST) ───────
# Create a free KV database at https://console.upstash.com
# If unset, subscribers are stored in data/newsletter-subscribers.json
# where the filesystem is writable (local dev) and logged otherwise.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
